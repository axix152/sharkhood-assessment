# Server
PORT=3000
NODE_ENV=development

# MongoDB
# provider_raw: strictly read-only source staging database
MONGO_RAW_URI=mongodb://localhost:27017/provider_raw
# provider_domain: clean, normalized, well-indexed destination database
MONGO_TARGET_URI=mongodb://localhost:27017/provider_domain

# Redis (BullMQ queue orchestration)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Factory & Queue Configuration
QUEUE_CONCURRENCY=3
BATCH_SIZE=50
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=2000
